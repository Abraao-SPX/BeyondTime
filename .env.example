# ==============================================================================
# BeyondTime — Exemplo de Variáveis de Ambiente (.env.example)
# NUNCA versione chaves reais no Git (Política de Governança — Seção 12)
# Copie este arquivo para .env: cp .env.example .env
# ==============================================================================

# 1. Banco de Dados Relacional (PostgreSQL — RF04)
POSTGRES_DB=beyondtime_db
POSTGRES_USER=beyondtime_user
POSTGRES_PASSWORD=beyondtime_dev_pass
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/beyondtime_db
SPRING_DATASOURCE_USERNAME=beyondtime_user
SPRING_DATASOURCE_PASSWORD=beyondtime_dev_pass

# 2. Autenticação JWT e OAuth2 Google (RF01)
JWT_SECRET_KEY=troque_por_uma_chave_secreta_de_no_minimo_256_bits_em_producao
GOOGLE_OAUTH_CLIENT_ID=seu_client_id_google.apps.googleusercontent.com

# 3. Inteligência Artificial Generativa — BeyondAssistant (RF10 / Spring AI)
OPENAI_API_KEY=sk-proj-sua_chave_openai_aqui
GEMINI_API_KEY=sua_chave_gemini_aqui
BEYONDASSISTANT_TIMEOUT_MS=2000

# 4. Reconhecimento Facial e Selo de Verificado 50+ (RF11 / reconhecimento-facial)
# Chave HS256 do token biométrico — use uma chave diferente da JWT_SECRET_KEY do RF01
BIOMETRIA_JWT_SECRET_KEY=troque_por_uma_chave_biometrica_aleatoria_de_32_bytes_ou_mais
BIOMETRIA_PORT=8000
# Em produção, restrinja às origens do app/site (separadas por vírgula)
BIOMETRIA_CORS_ALLOWED_ORIGINS=*
# URL do serviço usada pelo app mobile (Expo lê variáveis EXPO_PUBLIC_*)
EXPO_PUBLIC_BIOMETRIA_API_URL=http://SEU_IP_LOCAL:8000
