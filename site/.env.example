# ==============================================================================
# BeyondTime Web (React 18 + Vite) — Exemplo de Variáveis (site/.env.example)
# Copie para site/.env: cp site/.env.example site/.env
# ==============================================================================

# Em desenvolvimento local (npm run dev), deixe vazio para usar o proxy /api do Vite
# configurado em site/vite.config.ts apontando para http://localhost:8080:
VITE_API_BASE_URL=

# Caso queira apontar diretamente sem proxy, descomente a linha abaixo:
# VITE_API_BASE_URL=http://localhost:8080
